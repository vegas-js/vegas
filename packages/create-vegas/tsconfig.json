{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,

    /* Bundler mode */
    "moduleResolution": "bundler",

    /* Linting */
    "strict": true
  },
  "include": ["src", "tsdown.config.ts"]
}
