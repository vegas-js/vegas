{
  "schemaVersion": 1,
  "surfaces": {
    "ContentService": {
      "auditedMethods": ["createTextOutput"],
      "defaultBehavior": "implemented"
    },
    "ContentService.TextOutput": {
      "auditedMethods": [
        "append",
        "clear",
        "downloadAsFile",
        "getContent",
        "getFileName",
        "getMimeType",
        "setContent",
        "setMimeType"
      ],
      "defaultBehavior": "implemented",
      "behaviorOverrides": {
        "downloadAsFile": "local-emulation"
      }
    },
    "CacheService": {
      "auditedMethods": ["getDocumentCache", "getScriptCache", "getUserCache"],
      "defaultBehavior": "local-emulation"
    },
    "CacheService.Cache": {
      "auditedMethods": ["get", "getAll", "put", "putAll", "remove", "removeAll"],
      "defaultBehavior": "local-emulation"
    },
    "LockService": {
      "auditedMethods": ["getDocumentLock", "getScriptLock", "getUserLock"],
      "defaultBehavior": "local-emulation"
    },
    "LockService.Lock": {
      "auditedMethods": ["hasLock", "releaseLock", "tryLock", "waitLock"],
      "defaultBehavior": "local-emulation"
    },
    "HtmlService": {
      "auditedMethods": [
        "createHtmlOutput",
        "createHtmlOutputFromFile",
        "createTemplate",
        "createTemplateFromFile",
        "getUserAgent"
      ],
      "defaultBehavior": "local-emulation"
    },
    "HtmlService.HtmlOutput": {
      "auditedMethods": [
        "addMetaTag",
        "append",
        "appendUntrusted",
        "asTemplate",
        "clear",
        "getAs",
        "getBlob",
        "getContent",
        "getFaviconUrl",
        "getHeight",
        "getMetaTags",
        "getTitle",
        "getWidth",
        "setContent",
        "setFaviconUrl",
        "setHeight",
        "setSandboxMode",
        "setTitle",
        "setWidth",
        "setXFrameOptionsMode"
      ],
      "defaultBehavior": "implemented",
      "behaviorOverrides": {
        "addMetaTag": "local-emulation",
        "append": "local-emulation",
        "appendUntrusted": "local-emulation",
        "getAs": "fail-closed",
        "getBlob": "local-emulation",
        "setContent": "local-emulation",
        "setSandboxMode": "no-op"
      }
    },
    "HtmlService.HtmlTemplate": {
      "auditedMethods": ["evaluate", "getCode", "getCodeWithComments", "getRawContent"],
      "defaultBehavior": "local-emulation",
      "behaviorOverrides": {
        "getRawContent": "implemented"
      }
    },
    "Logger": {
      "auditedMethods": ["clear", "getLog", "log"],
      "defaultBehavior": "local-emulation"
    },
    "Session": {
      "auditedMethods": [
        "getActiveUser",
        "getActiveUserLocale",
        "getEffectiveUser",
        "getScriptTimeZone",
        "getTemporaryActiveUserKey",
        "getTimeZone",
        "getUser"
      ],
      "defaultBehavior": "local-emulation"
    },
    "Session.User": {
      "auditedMethods": ["getEmail", "getUserLoginId"],
      "defaultBehavior": "local-emulation"
    },
    "console.Console": {
      "auditedMethods": ["error", "info", "log", "time", "timeEnd", "warn"],
      "defaultBehavior": "local-emulation"
    },
    "PropertiesService": {
      "auditedMethods": ["getDocumentProperties", "getScriptProperties", "getUserProperties"],
      "defaultBehavior": "local-emulation"
    },
    "PropertiesService.Properties": {
      "auditedMethods": [
        "deleteAllProperties",
        "deleteProperty",
        "getKeys",
        "getProperties",
        "getProperty",
        "setProperties",
        "setProperty"
      ],
      "defaultBehavior": "local-emulation"
    },
    "Utilities": {
      "auditedMethods": [
        "base64Decode",
        "base64DecodeWebSafe",
        "base64Encode",
        "base64EncodeWebSafe",
        "computeDigest",
        "computeHmacSha256Signature",
        "computeHmacSignature",
        "computeRsaSha1Signature",
        "computeRsaSha256Signature",
        "computeRsaSignature",
        "formatDate",
        "formatString",
        "getUuid",
        "gzip",
        "jsonParse",
        "jsonStringify",
        "newBlob",
        "parseCsv",
        "parseDate",
        "sleep",
        "ungzip",
        "unzip",
        "zip"
      ],
      "defaultBehavior": "implemented",
      "behaviorOverrides": {
        "computeRsaSha1Signature": "local-emulation",
        "computeRsaSha256Signature": "local-emulation",
        "computeRsaSignature": "local-emulation",
        "formatDate": "local-emulation",
        "formatString": "local-emulation",
        "parseCsv": "local-emulation",
        "parseDate": "local-emulation",
        "unzip": "local-emulation",
        "zip": "local-emulation"
      }
    },
    "UrlFetchApp": {
      "auditedMethods": ["fetch", "fetchAll", "getRequest"],
      "defaultBehavior": "local-emulation",
      "behaviorOverrides": {
        "getRequest": "implemented"
      }
    },
    "UrlFetchApp.HTTPResponse": {
      "auditedMethods": [
        "getAllHeaders",
        "getAs",
        "getBlob",
        "getContent",
        "getContentText",
        "getHeaders",
        "getResponseCode"
      ],
      "defaultBehavior": "implemented",
      "behaviorOverrides": {
        "getAs": "fail-closed",
        "getContentText": "local-emulation",
        "getHeaders": "local-emulation"
      }
    }
  }
}
