{
  "name": "@vegasjs/vegas-monorepo",
  "private": true,
  "homepage": "https://vegasjs.dev",
  "license": "MIT",
  "author": "Yasushi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vegas-js/vegas.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown --config-loader native --workspace --publint --fail-on-warn",
    "license:check": "git diff --exit-code -- packages/vegas/LICENSE.md packages/create-vegas/LICENSE.md",
    "check": "pnpm docs:api-coverage:check && pnpm lint && pnpm test && pnpm build && pnpm license:check",
    "release:smoke": "node scripts/release-smoke.js",
    "release:check": "pnpm check && pnpm release:smoke",
    "docs:api-coverage": "node scripts/generate-runtime-api-coverage.js",
    "docs:api-coverage:check": "node scripts/generate-runtime-api-coverage.js --check",
    "docs:dev": "pnpm docs:api-coverage && pnpm --filter ./docs dev",
    "docs:build": "pnpm docs:api-coverage:check && pnpm --filter ./docs build",
    "docs:preview": "pnpm --filter ./docs preview"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@vegasjs/vegas": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.3.4"
}
