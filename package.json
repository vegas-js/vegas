{
  "name": "@vegasjs/vegas-monorepo",
  "private": true,
  "homepage": "https://vegasjs.dev",
  "license": "MIT",
  "author": "Yasushi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vegas-js/vegas.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "oxlint",
    "format": "oxfmt",
    "reference:update": "tsx packages/vegas/tools/reference/commands/update.ts",
    "reference:verify": "tsx packages/vegas/tools/reference/commands/verify.ts",
    "reference:test": "vitest run packages/vegas/tools/reference/vegas/runtime.spec.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown --config-loader native --workspace",
    "docs:dev": "pnpm --filter ./docs dev",
    "docs:build": "pnpm --filter ./docs build",
    "docs:preview": "pnpm --filter ./docs preview"
  },
  "devDependencies": {
    "@vegasjs/vegas": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.3.4"
}
