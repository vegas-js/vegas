{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    ":configMigration"
  ],
  "enabledManagers": ["npm", "github-actions"],
  "packageRules": [
    {
      "description": "Require maintainer approval for compatibility floor changes",
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies", "engines"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Filter npm updates by the supported Node.js range",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "constraintsFiltering": "strict"
    },
    {
      "description": "Keep create-vegas template dependencies aligned manually with Vite templates",
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/create-vegas/template-*/package.json"],
      "enabled": false
    },
    {
      "description": "Require maintainer approval for Node type declaration major updates",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep CI Node version changes as explicit maintainer decisions",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["node"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group Vitest updates",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vitest", "@vitest/coverage-v8"],
      "groupName": "Vitest"
    },
    {
      "description": "Group Oxc tooling updates",
      "matchManagers": ["npm"],
      "matchPackageNames": ["oxfmt", "oxlint", "oxlint-tsgolint"],
      "groupName": "Oxc tooling"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
